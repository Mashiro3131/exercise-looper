<!DOCTYPE html>

<html>
<head>
  <title>ExerciseLooper</title>

  <link rel="stylesheet" media="all" href="/assets/application-e361a13b57bec6b1bc6fea43b0400f8127b0a85379744dbede7e758ecee45ab6.css">

  <script src="/assets/application-9cc88e7fff85c68238012d6b999fd1e76e1d36d66c1ff1be28bfd9056bb845eb.js"></script>
</head>

<body>
<header class="heading managing">
  <section class="container">
    <a href="/">
      <img src="/assets/logo-84d7d70645fbe179ce04c983a5fae1e6cba523d7cd28e0cd49a04707ccbef56e.png">
    </a>

    <span class="exercise-label">
        Exercise:
        <a
          id="exercise-title"
          href="/exercises/<%= questionnaire["questionnaire_id"] %>/fields"
        >
          <%= questionnaire["title"] %>
        </a>
      </span>
  </section>
</header>

<main class="container">
  <div class="row">
    <section class="column">
      <h1>Fields</h1>

      <table class="records">
        <thead>
        <tr>
          <th>Label</th>
          <th>Value kind</th>
          <th></th>
        </tr>
        </thead>

        <tbody>
        <% questions.each do |question| %>
          <tr>
            <td><%= question["question_text"] %></td>
            <td><%= question["question_type_description"] %></td>

            <td>
              <a
                title="Edit"
                href="/exercises/<%= questionnaire["questionnaire_id"] %>/fields/<%= question["question_id"] %>/edit"
              >
                <i class="fa fa-edit"></i>
              </a>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>

      <a data-confirm="Are you sure? You won't be able to further edit this exercise" class="button" rel="nofollow" data-method="put" href="/exercises/<%= questionnaire["questionnaire_id"] %>?exercise[status]=answering"><i class="fa fa-comment"></i>Complete and be ready for answers</a>
    </section>
    <section class="column">
      <h1>New Field</h1>

      <form
        action="/exercises/<%= questionnaire["questionnaire_id"] %>/fields"
        method="post"
      >
        <div class="field">
          <label for="field_label">Label</label>

          <input
            type="text"
            name="field[label]"
            id="field_label"
            required
          >
        </div>

        <div class="field">
          <label for="field_value_kind">Value kind</label>

          <select name="field[value_kind]" id="field_value_kind">
            <option value="single_line">
              Single line text
            </option>

            <option value="single_line_list">
              List of single lines
            </option>

            <option value="multi_line">
              Multi-line text
            </option>
          </select>
        </div>

        <div class="actions">
          <input type="submit" value="Create Field">
        </div>
      </form>
    </section>
  </div>
</main>
</body>
</html>